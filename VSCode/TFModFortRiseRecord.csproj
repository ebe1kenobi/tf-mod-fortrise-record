<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ModLoaderPath>C:\Program Files (x86)\Steam\steamapps\common\TowerFall\FortRise</ModLoaderPath>

    <ModVersion>1.1.0</ModVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FortRise.Configuration" Version="1.5.6" />
    <!-- Encodage GIF (quantification + optimisation inter-images). FortRise resout
         les dependances d'un mod dans son propre dossier, donc la DLL doit etre
         livree a cote de celle du mod : d'ou CopyLocalLockFileAssemblies, sans quoi
         un projet bibliotheque ne la recopie pas dans bin/. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../ModFile/meta.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
